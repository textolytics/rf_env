  system init                      Initialize full system
  system verify                    Verify all systems operational
  system shutdown                  Graceful system shutdown
  system restart                   Restart entire system

DATABASE COMMANDS:
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  db shell                         Connect to PostgreSQL shell
