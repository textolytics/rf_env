#!/usr/bin/env make
# Market Data Platform - Makefile
# Comprehensive build, deployment, and management commands

.PHONY: help build start stop restart verify logs clean

# Colors for output
BLUE := \033[0;34m
GREEN := \033[0;32m
YELLOW := \033[1;33m
NC := \033[0m

# Project settings
PROJECT_NAME := market_data_platform
PROJECT_ROOT := $(PWD)
DOCKER_COMPOSE := docker-compose -f docker-compose.yml -f docker-compose.extended.yml
PYTHON := python3
GO := go
RUST := cargo

help:
	@echo "$(BLUE)Market Data Platform - Build & Deployment Commands$(NC)"
	@echo ""
	@echo "$(YELLOW)Installation & Setup:$(NC)"
	@echo "  make install              - Install all dependencies"
	@echo "  make install-python       - Install Python packages"
	@echo "  make install-go           - Install Go dependencies"
	@echo "  make install-rust         - Install Rust dependencies"
	@echo "  make install-system       - Install system libraries (libzmq, etc)"
	@echo ""
	@echo "$(YELLOW)Building:$(NC)"
	@echo "  make build                - Build all components"
	@echo "  make build-c              - Build C ZMQ services"
	@echo "  make build-go             - Build Go gateway"
	@echo "  make build-rust           - Build Rust validator"
	@echo "  make build-python         - Build Python packages"
	@echo "  make build-docker         - Build Docker images"
	@echo ""
	@echo "$(YELLOW)Starting & Stopping:$(NC)"
	@echo "  make start                - Start all services (gracefully)"
	@echo "  make stop                 - Stop all services (gracefully)"
	@echo "  make restart              - Restart all services"
	@echo "  make status               - Show service status"
	@echo ""
	@echo "$(YELLOW)Development:$(NC)"
	@echo "  make dev                  - Start in development mode"
	@echo "  make logs                 - Follow all service logs"
	@echo "  make logs-c               - Follow C service logs"
	@echo "  make logs-go              - Follow Go gateway logs"
	@echo "  make logs-rust            - Follow Rust processor logs"
	@echo ""
	@echo "$(YELLOW)Testing & Validation:$(NC)"
	@echo "  make verify               - Verify all components"
	@echo "  make test                 - Run all tests"
	@echo "  make test-python          - Run Python unit tests"
	@echo "  make test-go              - Run Go tests"
	@echo "  make test-rust            - Run Rust tests"
	@echo "  make test-integration     - Run integration tests"
	@echo ""
	@echo "$(YELLOW)Database & Migration:$(NC)"
	@echo "  make db-init              - Initialize database schema"
	@echo "  make db-migrate           - Run database migrations"
	@echo "  make db-reset             - Reset database (WARNING: deletes data)"
	@echo ""
	@echo "$(YELLOW)Monitoring & Dashboards:$(NC)"
	@echo "  make dashboard            - Open Grafana dashboard"
	@echo "  make metrics              - Show Prometheus metrics"
	@echo "  make health-check         - Run comprehensive health checks"
	@echo ""
	@echo "$(YELLOW)Cleanup:$(NC)"
	@echo "  make clean                - Remove build artifacts"
	@echo "  make clean-docker         - Remove Docker containers and volumes"
	@echo "  make clean-all            - Complete cleanup"
	@echo ""

install: install-system install-python install-go install-rust
	@echo "$(GREEN)✓ All dependencies installed$(NC)"

install-system:
	@echo "$(BLUE)→ Installing system libraries...$(NC)"
	sudo apt-get update && sudo apt-get install -y libzmq3-dev libzmq5 pkg-config git curl wget build-essential
	@echo "$(GREEN)✓ System libraries installed$(NC)"

install-python:
	@echo "$(BLUE)→ Installing Python dependencies...$(NC)"
	$(PYTHON) -m pip install -q -r requirements-dev.txt
	@echo "$(GREEN)✓ Python dependencies installed$(NC)"

install-go:
	@echo "$(BLUE)→ Installing Go dependencies...$(NC)"
	cd go && $(GO) mod download && $(GO) mod tidy
	@echo "$(GREEN)✓ Go dependencies installed$(NC)"

install-rust:
	@echo "$(BLUE)→ Installing Rust dependencies...$(NC)"
	cd rust && $(RUST) build --release 2>&1 | tail -5 || true
	@echo "$(GREEN)✓ Rust dependencies installed$(NC)"

build: build-c build-python build-go build-rust
	@echo "$(GREEN)✓ All components built$(NC)"

build-c:
	@echo "$(BLUE)→ Building C ZMQ services...$(NC)"
	mkdir -p c/zmq_core && cd c/zmq_core && \
	gcc -O3 -Wall publisher.c -o publisher -lzmq && \
	gcc -O3 -Wall subscriber.c -o subscriber -lzmq -lpthread
	@echo "$(GREEN)✓ C services compiled$(NC)"

build-python:
	@echo "$(BLUE)→ Building Python packages...$(NC)"
	$(PYTHON) setup.py build
	@echo "$(GREEN)✓ Python packages built$(NC)"

build-go:
	@echo "$(BLUE)→ Building Go gateway...$(NC)"
	cd go/cmd/gateway && $(GO) build -o gateway .
	@echo "$(GREEN)✓ Go gateway built$(NC)"

build-rust:
	@echo "$(BLUE)→ Building Rust validator...$(NC)"
	cd rust && $(RUST) build --release
	@echo "$(GREEN)✓ Rust validator built$(NC)"

build-docker:
	@echo "$(BLUE)→ Building Docker images...$(NC)"
	$(DOCKER_COMPOSE) build --no-cache
	@echo "$(GREEN)✓ Docker images built$(NC)"

start:
	@echo "$(BLUE)→ Starting all services...$(NC)"
	bash bin/start.sh
	@echo "$(GREEN)✓ All services started$(NC)"

stop:
	@echo "$(BLUE)→ Stopping all services...$(NC)"
	bash bin/stop.sh
	@echo "$(GREEN)✓ All services stopped$(NC)"

restart: stop start
	@echo "$(GREEN)✓ All services restarted$(NC)"

status:
	@echo "$(BLUE)→ Service Status:$(NC)"
	bash bin/verify_services.sh

dev:
	@echo "$(BLUE)→ Starting development environment...$(NC)"
	$(DOCKER_COMPOSE) up postgres redis influxdb grafana prometheus

logs:
	@echo "$(BLUE)→ Following all logs...$(NC)"
	tail -f logs/*.log

logs-c:
	@echo "$(BLUE)→ Following C service logs...$(NC)"
	tail -f logs/publisher.log logs/subscriber.log

logs-go:
	@echo "$(BLUE)→ Following Go gateway logs...$(NC)"
	$(DOCKER_COMPOSE) logs -f go-gateway

logs-rust:
	@echo "$(BLUE)→ Following Rust processor logs...$(NC)"
	$(DOCKER_COMPOSE) logs -f rust-processor

verify:
	@echo "$(BLUE)→ Verifying system...$(NC)"
	bash bin/verify_services.sh

test: test-python test-go test-rust test-integration
	@echo "$(GREEN)✓ All tests passed$(NC)"

test-python:
	@echo "$(BLUE)→ Running Python tests...$(NC)"
	$(PYTHON) -m pytest tests/ -v --tb=short 2>&1 | tail -20

test-go:
	@echo "$(BLUE)→ Running Go tests...$(NC)"
	cd go && $(GO) test ./... -v 2>&1 | tail -20

test-rust:
	@echo "$(BLUE)→ Running Rust tests...$(NC)"
	cd rust && $(RUST) test --release 2>&1 | tail -20

test-integration:
	@echo "$(BLUE)→ Running integration tests...$(NC)"
	@echo "  Testing data flow: Gateway → Redis → InfluxDB → Grafana"
	@echo "  Verifying ZMQ message distribution"
	@echo "  Checking API endpoints"

db-init:
	@echo "$(BLUE)→ Initializing database...$(NC)"
	$(DOCKER_COMPOSE) exec -T postgres psql -U postgres -d market_data < database/schema.sql
	@echo "$(GREEN)✓ Database initialized$(NC)"

db-migrate:
	@echo "$(BLUE)→ Running migrations...$(NC)"
	$(PYTHON) -m market_data_platform.migrations --apply
	@echo "$(GREEN)✓ Migrations completed$(NC)"

db-reset:
	@echo "$(YELLOW)! WARNING: This will delete all data$(NC)"
	@read -p "Are you sure? (y/n) " -n 1 -r; \
	echo ""; \
	if [[ $$REPLY =~ ^[Yy]$$ ]]; then \
		$(DOCKER_COMPOSE) exec -T postgres psql -U postgres -d market_data < database/schema.sql; \
		echo "$(GREEN)✓ Database reset$(NC)"; \
	else \
		echo "$(YELLOW)! Reset cancelled$(NC)"; \
	fi

dashboard:
	@echo "$(BLUE)→ Opening Grafana dashboard...$(NC)"
	@if command -v xdg-open &> /dev/null; then \
		xdg-open http://localhost:3000; \
	elif command -v open &> /dev/null; then \
		open http://localhost:3000; \
	else \
		echo "Please visit: http://localhost:3000 (admin/admin)"; \
	fi

metrics:
	@echo "$(BLUE)→ Fetching metrics...$(NC)"
	curl -s http://localhost:8080/metrics | jq .

health-check:
	@echo "$(BLUE)→ Running comprehensive health checks...$(NC)"
	bash bin/verify_services.sh

clean:
	@echo "$(BLUE)→ Cleaning build artifacts...$(NC)"
	rm -rf build/ dist/ *.egg-info
	rm -f c/zmq_core/publisher c/zmq_core/subscriber
	cd go && $(GO) clean
	cd rust && $(RUST) clean
	find . -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true
	find . -type f -name "*.pyc" -delete
	@echo "$(GREEN)✓ Cleanup complete$(NC)"

clean-docker:
	@echo "$(BLUE)→ Cleaning Docker containers...$(NC)"
	$(DOCKER_COMPOSE) down -v
	docker system prune -f
	@echo "$(GREEN)✓ Docker cleanup complete$(NC)"

clean-all: clean clean-docker
	@echo "$(GREEN)✓ Complete cleanup done$(NC)"

# Default target
.DEFAULT_GOAL := help
