# Market Data Platform - Environment Configuration Example
# Copy this to .env and update with your actual values

# ============================================================
# Server Configuration
# ============================================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=false
ENVIRONMENT=development

# ============================================================
# Database Configuration
# ============================================================
DATABASE_URL=postgresql://mdp_user:mdp_password@localhost:5432/market_data
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_ECHO=false

# ============================================================
# Redis Cache Configuration
# ============================================================
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=10
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# ============================================================
# Logging Configuration
# ============================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/var/log/market_data/app.log

# ============================================================
# Security Configuration
# ============================================================
SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
PASSWORD_MIN_LENGTH=8
CORS_ORIGINS=*

# ============================================================
# Gateway Configuration (Gate.io)
# ============================================================
GATEIO_API_KEY=your_gate_io_api_key
GATEIO_API_SECRET=your_gate_io_api_secret
GATEIO_API_ENDPOINT=https://api.gateio.ws/api/v4
GATEIO_WS_ENDPOINT=wss://ws.gateio.ws/v4
GATEIO_RATE_LIMIT_PER_SECOND=10
GATEIO_RECONNECT_INTERVAL=5
GATEIO_RECONNECT_MAX_RETRIES=10

# ============================================================
# ZMQ Configuration
# ============================================================
ZMQ_PUBLISHER_URL=tcp://127.0.0.1:5555
ZMQ_SUBSCRIBER_URL=tcp://127.0.0.1:5556
ZMQ_HIGH_WATER_MARK=1000

# ============================================================
# API Configuration
# ============================================================
API_VERSION=v1
API_PREFIX=/api/v1
API_TIMEOUT=30
API_MAX_REQUEST_SIZE=10485760
API_DOC_URL=/api/docs
API_WS_URL=/api/ws

# ============================================================
# Monitoring Configuration
# ============================================================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9000
PROMETHEUS_METRICS_PATH=/metrics
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health

# ============================================================
# Processing Configuration
# ============================================================
BATCH_SIZE=1000
BATCH_TIMEOUT_MS=100
WORKER_THREADS=4
DATA_RETENTION_DAYS=90

# ============================================================
# Notification Configuration
# ============================================================
NOTIFICATIONS_ENABLED=true
EMAIL_ENABLED=false
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_FROM_ADDRESS=noreply@marketdata.local
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=
WEBHOOK_ENABLED=true
WEBHOOK_RETRY_COUNT=3
WEBHOOK_RETRY_DELAY_SECONDS=60

# ============================================================
# Feature Flags
# ============================================================
ENABLE_TRADING=true
ENABLE_ANALYTICS=true
ENABLE_ALERTS=true
ENABLE_WEBSOCKET=true
MAINTENANCE_MODE=false

# ============================================================
# Docker & Kubernetes
# ============================================================
DOCKER_REGISTRY=docker.io
DOCKER_IMAGE_TAG=latest
KUBERNETES_NAMESPACE=market-data
KUBE_CONFIG_PATH=~/.kube/config

# ============================================================
# Backup & Maintenance
# ============================================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/var/backups/database

# ============================================================
# Rate Limiting
# ============================================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=3600
RATE_LIMIT_ENABLED=true

# ============================================================
# Storage Configuration
# ============================================================
STORAGE_TYPE=postgresql
STORAGE_BACKUP_ENABLED=true
STORAGE_VACUUM_ENABLED=true
STORAGE_ANALYZE_ENABLED=true

# ============================================================
# Go Gateway Configuration
# ============================================================
GO_GATEWAY_HOST=0.0.0.0
GO_GATEWAY_PORT=8080
GO_GATEWAY_METRICS_PORT=9000
GO_GATEWAY_LOG_LEVEL=info

# ============================================================
# Rust Processor Configuration
# ============================================================
RUST_PROCESSOR_LOG_LEVEL=info
RUST_PROCESSOR_BATCH_SIZE=1000
RUST_PROCESSOR_PROCESSING_INTERVAL_MS=100
RUST_PROCESSOR_METRICS_PORT=9001

# ============================================================
# Python API Configuration
# ============================================================
PYTHON_API_WORKERS=4
PYTHON_API_LOG_LEVEL=INFO
PYTHON_API_RELOAD=true

# ============================================================
# Optional: Custom Settings
# ============================================================
# Add any custom environment variables here
CUSTOM_VAR_1=value1
CUSTOM_VAR_2=value2
